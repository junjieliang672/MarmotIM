<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  marmot-asr-server LaunchAgent. In scripts/ this is a template whose placeholders
  (VENV_PYTHON, SERVER_DIR, MODEL, PORT, LOG_OUT, LOG_ERR, PATH — each written
  between at-signs) are substituted by scripts/install_asr.sh, which writes the
  result to ~/Library/LaunchAgents/com.marmotim.asr.plist. Edit the copy in scripts/
  and re-run the installer; editing the installed copy by hand is undone on the next
  run, since the installer compares the two and overwrites on any difference.

  Notes on the choices here:
    - ProgramArguments runs `python app.py`, NOT `uvicorn app:app`. app.py's main()
      reads MARMOT_ASR_* from the environment and calls uvicorn.run() itself; invoking
      uvicorn directly bypasses main() and takes host/port from uvicorn's flags
      instead (server/README.md §6).
    - MARMOT_ASR_HOST is pinned to 127.0.0.1. The server refuses any non-loopback bind
      (resolve_loopback_host raises ConfigError), so this is belt-and-braces, not the
      only guard.
    - HF_HUB_DISABLE_XET=1 is mandatory: the Xet transfer backend stalled at 0 bytes on
      this machine (server/README.md §4).
    - KeepAlive restarts the process whenever it exits, including after a crash;
      ThrottleInterval keeps a crash loop from spinning. RunAtLoad brings it back after
      a logout/login or reboot.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.marmotim.asr</string>

    <key>ProgramArguments</key>
    <array>
        <string>@VENV_PYTHON@</string>
        <string>-u</string>
        <string>@SERVER_DIR@/app.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@SERVER_DIR@</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH@</string>
        <key>HF_HUB_DISABLE_XET</key>
        <string>1</string>
        <key>MARMOT_ASR_HOST</key>
        <string>127.0.0.1</string>
        <key>MARMOT_ASR_PORT</key>
        <string>@PORT@</string>
        <key>MARMOT_ASR_MODEL</key>
        <string>@MODEL@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>@LOG_OUT@</string>
    <key>StandardErrorPath</key>
    <string>@LOG_ERR@</string>

    <key>ProcessType</key>
    <string>Adaptive</string>
</dict>
</plist>
